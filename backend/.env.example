# ===== Server Settings =====
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===== Concurrency & Resource Limits =====
# จำนวนการวิเคราะห์ลิงก์พร้อมกันสูงสุด (Default: 2)
MAX_CONCURRENT_ANALYZES=2
# จำนวนการดาวน์โหลดไฟล์พร้อมกันสูงสุด (Default: 2)
MAX_CONCURRENT_DOWNLOADS=2

# ===== Reverse Proxy & Public URL (Vercel / VPS / Reverse Proxy) =====
# กรณีต่อ Reverse proxy แล้ว URL backend หน้าเว็บภายนอกไม่ตรงกับ port 3001
# BACKEND_PUBLIC_URL=https://zentyr.online/api/zenload

# ===== Social Media Cookies (Optional / Fallback เมื่อไม่มี cookies.txt) =====
# INSTAGRAM_COOKIE=sessionid=...; ds_user_id=...; csrftoken=...;
# FACEBOOK_COOKIE=c_user=...; xs=...; datr=...;

# ===== Network Proxy (สำหรับแก้ YouTube Bot Block บน Cloud IP) =====
# YT_DLP_PROXY=http://user:pass@proxy-ip:port
# HTTPS_PROXY=http://user:pass@proxy-ip:port
